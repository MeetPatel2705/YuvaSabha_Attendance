PORT=4000
# Initial admin password — only used until it's changed from the admin
# panel's "Change password" button, which stores a hash in the database from
# then on. Changing this value after that point has no effect.
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Postgres connection string. Required.
# Local dev: a docker container works fine, e.g.
#   docker run -d --name attendance-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine
# Production: the connection string from Neon (neon.tech) or any hosted Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance
