PORT=4000
# Initial admin password — only used until it's changed from the admin
# panel's "Change password" button, which stores a hash in the database from
# then on. Changing this value after that point has no effect.
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional overrides — default to server/data/*.sqlite and server/data/backups/.
# On Render/Railway, point these at your persistent disk/volume mount path.
# SQLITE_PATH=/data/attendance.sqlite
# BACKUP_DIR=/data/backups
